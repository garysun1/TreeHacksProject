# === Required ===
ANTHROPIC_API_KEY=sk-ant-...           # Claude API key for agent SDK
BRIGHTDATA_API_KEY=...                 # Bright Data Web Scraper / Request API (optional; mock used if unset)
# Optional: BRIGHTDATA_ZONE=serp_api1   # For Request API (scrape by URL)
# Optional: BRIGHTDATA_AMAZON_SEARCH_DATASET_ID=...  # Dataset for Amazon search
# Optional: BRIGHTDATA_AMAZON_PRODUCT_DATASET_ID=gd_l7q7dkf244hwjntr0  # Product page details
# Optional: BRIGHTDATA_AMAZON_REVIEWS_DATASET_ID=...  # Product reviews
BROWSERBASE_API_KEY=...                # Browserbase API key
BROWSERBASE_PROJECT_ID=...             # Browserbase project ID
PERPLEXITY_API_KEY=pplx-...            # Perplexity Sonar API key

# === Optional ===
ELASTIC_CLOUD_ID=                      # Elasticsearch cloud ID (optional)
ELASTIC_API_KEY=                       # Elasticsearch API key (optional)

# === App Config ===
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR
AGENT_TIMEOUT=120                      # Default agent timeout in seconds
ENABLE_NEGOTIATION=true                # Enable/disable negotiation agent
